# ============================================================
# OSINT Tool -- Environment Variables
# Copy this file to .env and fill in your keys
#
#   cp .env.example .env
#   nano .env
#
# NEVER commit .env to git -- it is in .gitignore
# ============================================================

# HaveIBeenPwned API key -- $3.50/mo at haveibeenpwned.com/API/Key
HIBP_API_KEY=

# NumVerify API key -- free tier at numverify.com (250 req/month)
NUMVERIFY_API_KEY=

# Tor SOCKS5 proxy (default: local Tor daemon)
TOR_PROXY=socks5://127.0.0.1:9050
