[Unit]
Description=OSINT People & Identity Lookup Tool
Documentation=https://github.com/cahallchristopher/cahall-Cybersecurity-Portfolio/tree/main/projects/osint-tool
After=network.target tor@default.service
Wants=tor@default.service

# ── Notes ─────────────────────────────────────────────────────────────────────
# This service file runs the OSINT tool as a systemd-managed service.
# It ensures Tor is running first (Wants=tor@default.service) before starting.
#
# Install:
#   sudo cp osint-tool.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable osint-tool
#   sudo systemctl start osint-tool
#
# Check status:
#   sudo systemctl status osint-tool
#   journalctl -u osint-tool -f
# ─────────────────────────────────────────────────────────────────────────────

[Service]
Type=simple
User=chris
WorkingDirectory=/home/chris/osint-tool

# Load API keys from .env file
# Contains: HIBP_API_KEY, NUMVERIFY_API_KEY, TOR_PROXY
EnvironmentFile=/home/chris/osint-tool/.env

# Use the venv Python — NOT system Python
# Change 'chris' to your username if different
ExecStart=/home/chris/osint-tool/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000

# Restart automatically on failure
Restart=on-failure
RestartSec=5

# Logging — view with: journalctl -u osint-tool -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=osint-tool

[Install]
WantedBy=multi-user.target
